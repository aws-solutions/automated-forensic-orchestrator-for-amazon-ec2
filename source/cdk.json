{
    "app": "npx ts-node bin/forensic-cdk-solution.ts",
    "context": {
        "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
        "deployApi": false,
        "apiAllowedIps": [],
        "apiNotifications": false,
        "apiRateLimit": 1000,
        "forensicBucketComplianceMode": false,
        "forensicBucketRetentionDays": 30,
        "forensicBucketAccessIamRoleNames": [],
        "ssmDocumentsDir": "./ssm-documents",
        "vol2ProfilesBucket": "",
        "ssmExecutionTimeout": "1800",
        "diskSize": "512",
        "forensicInstanceType": "m6i.2xlarge,m6a.2xlarge,m5.2xlarge,m5a.2xlarge",
        "memoryAcquisitionTools": "lime,avml",
        "forensicImageName": "forensic-analysis-ami",
        "appForensicAliasKMS": "forensickey",
        "applicationAccounts": [
            "*"
        ],
        "customerManagedCMKArns": {},
        "ec2ForensicImage": "",
        "sandbox": true,
        "toolsAMI": {},
        "imageBuilderPipelines": [
            {
                "name": "forensic-analysis",
                "dir": "./image-builder-components",
                "cfnImageRecipeName": "forensic-analysis-al2023",
                "version": "1.3.0",
                "parentImageSsmParameter": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64",
                "instanceTypes": [
                    "t3.large",
                    "t3.xlarge"
                ],
                "rootVolumeSizeGiB": 30,
                "buildSchedule": "cron(0 8 1 * ? *)",
                "buildOnDeploy": true
            }
        ],
        "vpcInfo": {
            "vpcCidr": "10.1.0.0/16",
            "maxAZs": 2,
            "bastionInstance": false,
            "enableVpcFlowLog": true,
            "enableVPCEndpoints": true,
            "subnetConfig": [
                {
                    "cidrMask": 24,
                    "name": "externalDMZ",
                    "subnetType": "Public",
                    "mapPublicIpOnLaunch": false
                },
                {
                    "cidrMask": 24,
                    "name": "service",
                    "subnetType": "Private"
                },
                {
                    "cidrMask": 24,
                    "name": "database",
                    "subnetType": "Isolated"
                },
                {
                    "cidrMask": 24,
                    "name": "internalDMZ",
                    "subnetType": "Isolated"
                }
            ]
        },
        "vpcConfigDetails": {
            "isExistingVPC": false,
            "enableVPCEndpoints": false,
            "enableVpcFlowLog": false
        }
    }
}
