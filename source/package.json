{
    "name": "forensic-cdk-solution",
    "version": "2.0.0",
    "bin": {
        "cdk-solution": "bin/forensic-cdk-solution.js"
    },
    "scripts": {
        "lint": "eslint --fix --ext .ts . && prettier --write './**/*.{ts,js,mjs,json}' ",
        "cleanup": "tsc --build ./ --clean && rm -rf node_modules && rm -f package-lock.json",
        "cleanup:tsc": "tsc --build ./ --clean",
        "build": "npm run build-lambda",
        "watch": "tsc -w",
        "test": "jest test -- -u",
        "test:coverage": "jest test --coverage",
        "cdk": "cdk",
        "synth": "cdk context --clear && cdk synth -q",
        "build-lambda": "make install && make test",
        "all": "npm ci && npm run lint &&  npm run build && npm run test && tsc && npm run synth",
        "deploy": "cdk deploy --all",
        "deploy:forensic": "cdk deploy --all -c STACK_BUILD_TARGET_ACCT=forensicAccount",
        "deploy:security-hub": "cdk deploy --all -c STACK_BUILD_TARGET_ACCT=securityHubAccount",
        "destroy": "cdk destroy --all",
        "release:patch": "standard-version --release-as patch",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "release": "standard-version"
    },
    "devDependencies": {
        "@types/jest": "30.0.0",
        "rimraf": "6.1.3"
    },
    "peerDependencies": {
        "constructs": "^10.0.0"
    },
    "dependencies": {
        "@babel/core": "7.29.7",
        "@eslint/js": "^10.0.1",
        "@types/node": "^20.19.43",
        "aws-cdk": "^2.1137.0",
        "aws-cdk-lib": "2.265.0",
        "@aws-sdk/client-cloudformation": "^3.1113.0",
        "@aws-sdk/client-cloudwatch": "^3.1113.0",
        "@aws-sdk/client-dynamodb": "^3.1113.0",
        "@aws-sdk/client-ec2": "^3.1113.0",
        "@aws-sdk/client-iam": "^3.1113.0",
        "@aws-sdk/client-lambda": "^3.1113.0",
        "@aws-sdk/client-s3": "^3.1113.0",
        "@aws-sdk/client-securityhub": "^3.1113.0",
        "@aws-sdk/client-sfn": "^3.1113.0",
        "@aws-sdk/client-sns": "^3.1113.0",
        "@aws-sdk/client-ssm": "^3.1113.0",
        "@aws-sdk/client-sts": "^3.1113.0",
        "cdk-nag": "^2.38.2",
        "constructs": "^10.8.1",
        "eslint": "10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "jest": "30.4.2",
        "jest-junit": "^17.0.0",
        "prettier": "3.9.6",
        "source-map-support": "0.5.21",
        "ts-jest": "29.4.12",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.67.0"
    },
    "overrides": {
        "semver": "^7.5.3",
        "optionator": "^0.9.3"
    }
}
