{
    "name": "forensic-cdk-solution",
    "version": "1.3.2",
    "bin": {
        "cdk-solution": "bin/forensic-cdk-solution.js"
    },
    "scripts": {
        "lint": "eslint --fix --ext .ts . && prettier --write './**/*.{ts,js,json}' ",
        "cleanup": "tsc --build ./ --clean && rm -rf node_modules && rm -f package-lock.json",
        "cleanup:tsc": "tsc --build ./ --clean",
        "build": "npm run build-lambda",
        "watch": "tsc -w",
        "test": "jest test -- -u",
        "test:coverage": "jest test --coverage",
        "cdk": "cdk",
        "synth": "cdk context --clear && cdk synth -q",
        "build-lambda": "make install && make test",
        "all": "npm ci && npm run lint &&  npm run build && npm run test && tsc && npm run synth",
        "deploy": "cdk deploy --all",
        "deploy:forensic": "cdk deploy --all -c STACK_BUILD_TARGET_ACCT=forensicAccount",
        "deploy:security-hub": "cdk deploy --all -c STACK_BUILD_TARGET_ACCT=securityHubAccount",
        "destroy": "cdk destroy --all",
        "release:patch": "standard-version --release-as patch",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "release": "standard-version"
    },
    "devDependencies": {
        "@types/jest": "29.5.1",
        "@types/uuid": "^9.0.8",
        "rimraf": "5.0.0"
    },
    "peerDependencies": {
        "constructs": "^10.0.0"
    },
    "dependencies": {
        "@babel/core": "7.29.0",
        "@aws-cdk/assert": "2.46.0",
        "@types/node": "20.14.0",
        "@typescript-eslint/eslint-plugin": "5.30.5",
        "@typescript-eslint/parser": "5.30.5",
        "aws-cdk": "^2.1119.0",
        "aws-cdk-lib": "2.251.0",
        "@aws-sdk/client-cloudformation": "^3.1038.0",
        "@aws-sdk/client-cloudwatch": "^3.1038.0",
        "@aws-sdk/client-dynamodb": "^3.1038.0",
        "@aws-sdk/client-ec2": "^3.1038.0",
        "@aws-sdk/client-iam": "^3.1038.0",
        "@aws-sdk/client-lambda": "^3.1038.0",
        "@aws-sdk/client-s3": "^3.1038.0",
        "@aws-sdk/client-securityhub": "^3.1038.0",
        "@aws-sdk/client-sfn": "^3.1038.0",
        "@aws-sdk/client-sns": "^3.1038.0",
        "@aws-sdk/client-ssm": "^3.1038.0",
        "@aws-sdk/client-sts": "^3.1038.0",
        "cdk-nag": "^2.38.2",
        "constructs": "^10.6.0",
        "eslint": "8.19.0",
        "eslint-config-prettier": "^8.10.2",
        "eslint-config-typescript": "^3.0.0",
        "eslint-plugin-header": "^3.1.1",
        "eslint-plugin-prettier": "4.2.1",
        "fs": "^0.0.1-security",
        "jest": "29.5.0",
        "jest-junit": "^17.0.0",
        "prettier": "2.7.1",
        "source-map-support": "0.5.21",
        "ts-jest": "29.4.9",
        "ts-node": "10.9.2",
        "typescript": "5.0.4",
        "uuid": "^14.0.1"
    },
    "overrides": {
        "semver": "^7.5.3",
        "optionator": "^0.9.3"
    }
}
